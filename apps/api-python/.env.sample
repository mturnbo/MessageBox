MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dbuser
MYSQL_PASSWORD=dbpassword
MYSQL_DATABASE=messaging

JWT_SECRET=
JWT_EXPIRATION_TIME=86400
JWT_REFRESH_EXPIRATION_TIME=604800
JWT_ISSUER=messagebox-api-python
JWT_AUDIENCE=messagebox

PORT=8000
ORIGIN=4000

ENV=development
LOG_LEVEL=INFO
SQL_ECHO=false

AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW_MS=60000
# Shared rate limit storage, e.g. redis://localhost:6379 when running more than one process
RATE_LIMIT_STORAGE_URI=memory://
